# Xcode
xcuserdata/
*.xcscmblueprint
DerivedData/
.derivedData/
build/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.xcworkspace
!default.xcworkspace

# XcodeGen generates each app's .xcodeproj, Info.plist, and entitlements from
# its project.yml — none of these are committed.
*.xcodeproj/
*/Info.plist
*/WidgetsInfo.plist
*/WatchInfo.plist
*/*.entitlements
# …except Nine's iOS entitlements: xcodegen emits one entitlements file per
# target, and the iOS app needs a second (app group) applied per-SDK, so this
# one is checked in (PRD-3).
!nine/Nine-iOS.entitlements
# …and Nine's macOS entitlements (sandbox + KVS + game-center), applied per-SDK
# the same way, so the CI mac archive can find it (PRD-4).
!nine/Nine-macOS.entitlements
# …and Nine's tvOS entitlements (game-center + KVS + CloudKit), a checked-in
# file replacing the generated default so tvOS carries the CloudKit container
# (PRD-8).
!nine/Nine-tvOS.entitlements
# …and the watch app's, which is checked in for a different reason: its KVS
# identifier is a literal pinned to the *app's* bundle id, not its own, so it
# cannot be a generated `$(CFBundleIdentifier)` expansion (PRD-6).
!nine/NineWatch.entitlements

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Build / TestFlight output (scripts/testflight.sh)
*/build/
*/dist/

# Local signing configuration (team ID, ASC API key) — never committed.
signing.env

# macOS
.DS_Store
*.swp
*~

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/screenshots/**/*.png
fastlane/test_output
*.mobileprovision
*.p12
*.p8
*/build-tvos/

# Local xcodebuild derived data (per-platform, created during validation)
.build-ios/
.build-tvos/
.build-mac/
*/.build-ios/
*/.build-tvos/
*/.build-mac/

# PRD-19 AX-tree lane: what a comparison run actually captured, beside the
# committed baselines. Only the baselines are the contract.
nine/Tests/AXBaselines/.captured/

# PRD-22 contrast lane, same shape — except these are 12 MB screenshots each,
# so leaving them untracked is not a preference. `matrix.txt` beside them is
# the contract and is committed.
nine/Tests/ContrastBaselines/.captured/

# PRD-20 localization lane, same shape again: 25 dumps and 25 screenshots per
# run (five screens x en/de/ja/double/rtl). The `.txt` baselines beside them are
# the contract and are committed.
nine/Tests/LocBaselines/.captured/
