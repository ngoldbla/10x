      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just started"
          }
        }
      }
    },
    "board.progress.filled" : {
      "comment" : "VoiceOver board summary. %1$lld squares filled of %2$lld fillable.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld filled."
          }
        }
      }
    },
    "board.progress.full" : {
      "comment" : "The words beside a board with every square filled in. An adjective, not \"Solved\" — a full board may still be wrong.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full"
          }
        }
      }
    },
    "board.progress.percent" : {
      "comment" : "How far through a board the player is, as a percentage. %1$lld is 3-100; `%%` is a literal percent sign. Place the sign the way this language does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%%"
          }
        }
      }
    },
    "board.progress.untouched" : {
      "comment" : "The words beside a saved board that has not been played at all. Said instead of \"0%\", which reads as failure rather than as a fresh start.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untouched"
          }
        }
      }
    },
    "board.progress.wrong" : {
      "comment" : "VoiceOver board summary: how many placed digits contradict the solution. %1$lld is the count. Only spoken with mistake-marking on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld wrong."
          }
        }
      }
    },
    "board.rose.digit" : {
      "comment" : "VoiceOver label of the ring of nine petals that appears over a square. \"Rose\" is Nine's name for that circular picker — keep the flower metaphor if this language has one, or describe it plainly.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit rose"
          }
        }
      }
    },
    "board.rose.note" : {
      "comment" : "VoiceOver label of the same ring when it writes pencil marks rather than real digits.",
