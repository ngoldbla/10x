          "stringUnit" : {
            "state" : "translated",
            "value" : "Cage Combination"
          }
        }
      }
    },
    "technique.cageSingle.name" : {
      "comment" : "Killer-sudoku technique name, coach card heading: a cage whose sum leaves one possibility. Use this language's established killer-sudoku term if it has one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cage Single"
          }
        }
      }
    },
    "technique.hiddenPair.name" : {
      "comment" : "Sudoku technique name, coach card heading: two digits confined to the same two squares. Use this language's established sudoku term if it has one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden Pair"
          }
        }
      }
    },
    "technique.hiddenSingle.name" : {
      "comment" : "Sudoku technique name, coach card heading: a digit that fits only one square in a unit. Use this language's established sudoku term if it has one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden Single"
          }
        }
      }
    },
    "technique.innieOutie.name" : {
      "comment" : "Killer-sudoku technique name, coach card heading. Known in English as the rule of 45, because a row, column or box always sums to 45. Use this language's established term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rule of 45"
          }
        }
      }
    },
    "technique.nakedPair.name" : {
      "comment" : "Sudoku technique name, coach card heading: two squares sharing exactly two candidates. Use this language's established sudoku term if it has one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naked Pair"
          }
        }
      }
    },
    "technique.nakedSingle.name" : {
      "comment" : "Sudoku technique name, coach card heading: a square with only one candidate left. Use this language's established sudoku term if it has one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naked Single"
          }
        }
      }
    },
    "technique.thermoBound.name" : {
      "comment" : "Thermometer-sudoku technique name, coach card heading: digits must increase along a thermometer, which bounds each bulb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thermometer Bound"
          }
        }
      }
    },
    "technique.xWing.name" : {
      "comment" : "Sudoku technique name, coach card heading. Almost always left as \"X-Wing\" — it is a term of art, not a description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X-Wing"
          }
        }
      }
    },
    "theme.auto" : {
      "comment" : "Name of the theme that follows the system's light or dark setting rather than pinning one. Short — it sits beside a swatch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto"
          }
        }
      }
    },
    "theme.blueprint" : {
      "comment" : "Name of a deep blue theme, after the architectural drawing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blueprint"
          }
        }
      }
    },
    "theme.camel" : {
      "comment" : "Name of a warm, sandy light theme — the colour, not the animal, if this language separates them.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camel"
          }
        }
      }
    },
    "theme.dark" : {
      "comment" : "Name of the dark theme: near-black, the app's default and its identity. A noun — empty space — not the verb \"to void\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Void"
          }
        }
      }
    },
    "theme.ember" : {
      "comment" : "Name of a dark rust-red theme, after a dying coal. Same word as the accent of the same name — keep them identical.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember"
          }
        }
      }
    },
    "theme.forest" : {
      "comment" : "Name of a dark green theme.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forest"
          }
        }
      }
    },
    "theme.light" : {
      "comment" : "Name of the light theme: an off-white page. The material, not a document.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paper"
          }
        }
      }
    },
    "theme.mono" : {
      "comment" : "Name of a neutral grey theme with no colour in it at all. Short for monochrome; keep it abbreviated if this language does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono"
          }
        }
      }
    },
    "theme.tide" : {
      "comment" : "Name of a dark blue-green theme, after the sea.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tide"
          }
        }
      }
    },
    "tip.highlight" : {
      "comment" : "One of three lifetime tips, shown once in a chip. Explains that tapping a placed digit highlights every other copy of it on the board.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any placed digit to light up every one of its kind."
          }
        }
      }
    },
    "tip.pencil" : {
      "comment" : "One of three lifetime tips, shown once in a chip. Explains that the pencil toggle turns entry into corner notes. \"the rose\" is Nine's circular digit picker — keep the metaphor if the language has one, describe it plainly if not.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the pencil, then flick — the rose leaves corner notes instead."
          }
        }
      }
    },
    "tip.undo" : {
      "comment" : "One of three lifetime tips, shown once in a chip. Explains that undo exists and that nothing can be ruined. Two short sentences; reassuring, never scolding.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo takes the last digit back. Nothing here is ever stuck."
          }
        }
      }
    },
    "tutorial.button.done" : {
      "comment" : "Button that closes the tutorial on its last beat. Use the same word this language's system UI uses to finish a sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "tutorial.button.skipStep" : {
      "comment" : "The escape hatch under a tutorial beat: move on without doing the exercise.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip this step"
          }
        }
      }
    },
    "tutorial.button.tryIt" : {
      "comment" : "Button that leaves the tutorial's first beat and starts the playable part. A verb in the imperative, two words.",
