    "tutorial.close" : {
      "comment" : "VoiceOver label of the ✕ that leaves the tutorial.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close tutorial"
          }
        }
      }
    },
    "tutorial.difficulty.body" : {
      "comment" : "The promise behind every board Nine composes, plus how points work. \"Provably\" is load-bearing: the app verifies it, so this is a claim of fact.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every difficulty is provably solvable by logic alone — no guessing, ever. Solves earn points; faster and harder earns more."
          }
        }
      }
    },
    "tutorial.difficulty.title" : {
      "comment" : "Heading of the tutorial's last beat, which explains the four difficulty bands. A wry idiom for \"choose how hard you want it\" — replace it with an equivalent idiom rather than translating the words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick your poison"
          }
        }
      }
    },
    "tutorial.digit.placeholder" : {
      "comment" : "Stands in for a numeral in the tutorial's instructions before the practice board has finished generating. Lowercase, mid-sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "digit"
          }
        }
      }
    },
    "tutorial.goal.body" : {
      "comment" : "The rules of sudoku in one sentence, plus what this practice board is. \"Box\" is the 3×3 block — use this language's sudoku vocabulary. The dash is an em dash; the range is an en dash.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill every row, column and 3×3 box with 1–9 — each digit exactly once. This board is nearly done; you'll finish a piece of it."
          }
        }
      }
    },
    "tutorial.goal.title" : {
      "comment" : "Heading of the tutorial's first beat, which explains what solving a sudoku means.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal"
          }
        }
      }
    },
    "tutorial.highlight.title" : {
      "comment" : "Heading of the tutorial beat that teaches the same-number highlight. The numerals are examples and stay as numerals.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find every 9 (or 5, or 2…)"
          }
        }
      }
    },
    "tutorial.nice" : {
      "comment" : "A chip shown for a moment when the player completes a tutorial exercise. Warm and brief — praise, not a score. One word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice"
          }
        }
      }
    },
    "tutorial.pad.beginBody" : {
      "comment" : "The tutorial's first beat on a game controller: the shared explanation followed by the button to press. %1$@ is `tutorial.goal.body`. \"Cross\" is the controller button — use the name this language's controller documentation gives it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Press Cross to begin."
          }
        }
      }
    },
    "tutorial.pad.finish" : {
      "comment" : "A chip on the controller tutorial's last beat: pressing this button closes the tutorial. \"Cross\" is a controller button name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Cross — done"
          }
        }
      }
    },
    "tutorial.pad.readyBody" : {
      "comment" : "The tutorial's last beat on a game controller. %1$@ is `tutorial.difficulty.body`. \"Cross\" is a controller button name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Press Cross when you're ready."
          }
        }
      }
    },
    "tutorial.pad.skip" : {
      "comment" : "A chip offering the escape hatch on Apple TV. \"Menu\" is the Siri Remote's back button — use the name printed in this language's Apple TV documentation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
