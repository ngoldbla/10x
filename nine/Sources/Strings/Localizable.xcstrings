    "coach.hiddenSingle.sentence.box": {
      "comment": "Coach explanation, hidden single confined to a 3x3 BOX. %1$lld is the box number (1-9, reading order), %2$lld the digit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur ein Feld in Block %1$lld kann eine %2$lld aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one square in box %1$lld can take a %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo una casilla del bloque %1$lld admite un %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une seule case du bloc %1$lld peut recevoir un %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo una casella del riquadro %1$lld può contenere un %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lldブロックで %2$lld が入るマスは1つだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld번 박스에서 %2$lld 후보가 남은 칸은 하나뿐이에요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maar één vakje in blok %1$lld kan een %2$lld bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só uma célula do bloco %1$lld pode receber um %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 宫里只有一个格子能放 %2$lld。"
          }
        }
      }
    },
    "coach.hiddenSingle.sentence.cell": {
      "comment": "Coach explanation, hidden single when no containing unit could be named — so this one names the square instead. %1$lld is the row, %2$lld the column, %3$lld the digit. Mentions no row, column or box.",
      "extractionState": "manual",
      "localizations": {
