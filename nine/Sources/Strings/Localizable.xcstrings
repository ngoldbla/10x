    "tutorial.today.body": {
      "comment": "What the daily puzzle is, in the tutorial's last beat. %1$@ is a difficulty name — the band the daily always composes at. \"Shared\" means every player gets the same board that day.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein gemeinsames Spielfeld pro Tag, Stufe %1$@. Löse es täglich, damit deine Serie wächst – Serien vervielfachen deine Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One shared %1$@ board a day. Solve it daily to grow your streak — streaks multiply your points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un tablero %1$@ compartido cada día. Resuélvelo a diario para aumentar tu racha: las rachas multiplican tus puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une grille %1$@ partagée chaque jour. Résolvez-la quotidiennement pour allonger votre série — les séries multiplient vos points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una griglia condivisa al giorno, livello %1$@. Risolvila ogni giorno per far crescere la tua serie — le serie moltiplicano i punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1日1つ、みんな同じ%1$@の盤面です。毎日解くと連続記録が伸び、連続記録はポイントを増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하루에 한 번, 모두가 같은 %1$@ 보드를 풀어요. 매일 풀면 연속 기록이 늘고, 연속 기록은 점수를 배로 늘려 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eén gedeeld %1$@-bord per dag. Los het dagelijks op om je reeks te laten groeien — een reeks vermenigvuldigt je punten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um tabuleiro %1$@ compartilhado por dia. Resolva todo dia para aumentar sua sequência — sequências multiplicam seus pontos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每天一张共享的 %1$@ 棋盘。每天解开它，连续天数就会增长 —— 连续天数会让你的积分翻倍。"
          }
        }
      }
    },
