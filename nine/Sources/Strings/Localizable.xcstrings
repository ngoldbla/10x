    "grammar.keyboard.pencilDetail": {
      "comment": "The Mac keyboard instruction for pencil notes. \"Shift\" and \"P\" are key names; \"sticky\" means the mode stays on until switched off.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte Umschalt und drücke eine Ziffer für eine Notiz — klein in der Ecke, bis eine echte Ziffer kommt. P schaltet den Bleistift dauerhaft ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Shift and press a digit to pencil a note — small in the corner until a real digit lands. Press P for sticky pencil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén Mayús y pulsa un número para anotarlo a lápiz: queda pequeño en la esquina hasta que llegue un número de verdad. Pulsa P para el lápiz fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maintenez Maj et appuyez sur un chiffre pour poser une note — petite dans le coin jusqu’à ce qu’un vrai chiffre arrive. Appuyez sur P pour le crayon permanent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni premuto Maiuscole e premi una cifra per annotarla a matita — piccola nell'angolo finché non arriva una cifra vera. Premi P per la matita fissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shift を押しながら数字キーを押すとメモを書けます。確定の数字が入るまで隅に小さく残ります。P でメモモードを固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shift를 누른 채 숫자를 누르면 메모가 남아요 — 진짜 숫자가 들어올 때까지 구석에 작게 있어요. P를 누르면 연필이 계속 켜져 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd Shift ingedrukt en druk op een cijfer om een notitie te zetten — klein in de hoek tot er een echt cijfer landt. Druk op P voor vast potlood."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segure Shift e aperte um dígito para anotar a lápis — pequeno no canto até um dígito de verdade chegar. Aperte P para o lápis fixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按住 Shift 再按数字键，就能写下一条笔记 —— 它小小地待在角落，直到真正的数字落下。按 P 键进入常开笔记。"
          }
        }
      }
    },
    "grammar.keyboard.pencilVerb": {
      "comment": "The Mac keyboard's verb for entering a pencil note: hold Shift while typing the digit. \"Shift\" is the key name and keeps its capital.",
