      "comment": "What the History sheet says before there is enough history to chart. Explains what will appear, without urging the player to go and play.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löse ein Spielfeld und es landet hier — Zeit, Stufe und Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve a board and it lands here — time, difficulty and points."
          }
        },
        "es": {
