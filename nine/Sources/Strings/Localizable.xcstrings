          }
        }
      }
    },
    "shelf.boards.subtitleEmpty" : {
      "comment" : "Subtitle of the Apple TV shelf's Boards tile when nothing is in progress — the three things the sheet is for. A list of verbs, not a sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume, archive, replay"
          }
        }
      }
    },
    "shelf.continue.caption" : {
      "comment" : "Caption under the Continue card. %1$@ is a difficulty name (\"Steady\"), %2$@ a progress phrase (\"41%\"). Punctuation only — reorder if this language reads the other way round.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "shelf.continue.captionMore" : {
      "comment" : "Caption under the Continue card when other unfinished boards exist too. %1$@ is a difficulty name, %2$@ a progress phrase, %3$lld a count of OTHER boards (1 or more).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · +%3$lld more"
          }
        }
      }
    },
    "shelf.continue.discard" : {
      "comment" : "VoiceOver label of the ✕ on the Continue card. Throws the saved board away; it is not a close button.",
