    "why.heading": {
      "comment": "Heading of the why-chain card, shown while the coach explains one square. %1$lld is the digit the square must hold. A question, because the player asked one. It carries NO article on purpose — the English was \"Why a %1$lld?\" and rendered \"Why a 8?\", and choosing a/an from a numeral is English grammar that no other language shares. If this language needs an article before a numeral, write the one that is always correct or rephrase.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Warum muss hier %1$lld stehen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why must this be %1$lld?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Por qué tiene que ser %1$lld?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pourquoi est-ce forcément %1$lld ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perché deve essere %1$lld?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "なぜここは %1$lld なの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "왜 여기는 %1$lld일까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waarom moet dit %1$lld zijn?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por que tem que ser %1$lld?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这里为什么一定是 %1$lld？"
          }
        }
      }
    },
    "why.position": {
