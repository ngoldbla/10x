    "school.lesson.look": {
      "comment": "Instruction at the start of a lesson, before the pattern is revealed. \"Settled\" means the square's digit is now forced. Encourages looking before being told.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Irgendwo auf diesem Brett ist ein Feld bereits festgelegt. Sieh erst selbst nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere on this board, one square is settled. Look first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En algún lugar de este tablero hay una casilla ya determinada. Búscala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quelque part sur cette grille, une case est déjà déterminée. Cherche d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da qualche parte in questa griglia una casella è già determinata. Prima cercala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この盤のどこかに、もう決まっているマスがあります。まず探してみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 판 어딘가에 이미 정해진 칸이 있습니다. 먼저 찾아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ergens op dit bord ligt één vakje al vast. Kijk eerst zelf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em algum lugar deste tabuleiro há uma célula já determinada. Procure primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这盘棋里有一个格子已经定下来了。先自己找找看。"
          }
        }
      }
    },
