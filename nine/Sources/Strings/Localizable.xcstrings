    "coach.boxLine.body" : {
      "comment" : "Coach explanation, box-line reduction. %1$@ is a digit as a word, %2$@ and %3$@ are unit names. Note %1$@ and %3$@ each appear TWICE — if you reorder the sentence, move every occurrence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every %1$@ still possible in %2$@ sits in %3$@, so no other square in %3$@ can be a %1$@."
          }
        }
      }
    },
    "coach.exhausted.body" : {
      "comment" : "Coach card body when no technique at this board's level applies.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing at this board's level follows from here."
          }
        }
      }
    },
    "coach.exhausted.title" : {
      "comment" : "Coach card heading when the board is consistent but no technique at its level applies. Not an error — the hint has simply run out.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing follows"
          }
        }
      }
    },
    "coach.hiddenPair.body" : {
      "comment" : "Coach explanation, hidden pair. %1$@ and %2$@ are digits as words, %3$@ a unit's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ fit only these two squares in %3$@, so nothing else fits there."
          }
        }
      }
    },
    "coach.hiddenSingle.body" : {
      "comment" : "Coach explanation, hidden single. %1$@ is a unit's name (\"Box 3\"), %2$@ a digit as a word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one square in %1$@ can take a %2$@."
          }
        }
      }
    },
    "coach.hiddenSingle.fallback" : {
      "comment" : "Coach explanation, hidden single, when no containing unit was derived. %1$@ is a square's name, %2$@ a digit as a word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is the only square left that can take a %2$@."
          }
        }
      }
    },
    "coach.nakedPair.body" : {
      "comment" : "Coach explanation, naked pair. %1$@ and %2$@ are digits as words, %3$@ a unit's name (\"Row 7\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$@ fill these two squares between them, so neither can go anywhere else in %3$@."
          }
        }
      }
    },
    "coach.nakedSingle.body" : {
      "comment" : "Coach explanation, naked single. %1$@ is a square's name (\"Row 4, column 2\"), %2$@ a digit as a word (\"seven\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has one candidate left: %2$@."
          }
        }
      }
    },
    "coach.slip.body" : {
      "comment" : "Coach card body when two squares contradict each other. Says that nothing can follow, without saying which square is wrong.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two of these squares disagree, so nothing can follow from here."
          }
        }
      }
    },
    "coach.slip.title" : {
      "comment" : "Coach card heading when two squares contradict each other, so no hint is possible. Gentle and blameless: the player made a slip, they did not fail.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slip somewhere"
          }
        }
      }
    },
    "coach.solved.title" : {
      "comment" : "Coach card heading when the board is finished. One word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "coach.xWing.body" : {
      "comment" : "Coach explanation, X-wing. %1$@ and %4$@ are the same digit as a word, %2$@ and %3$@ are the words \"rows\"/\"columns\". %3$@ appears twice — if you reorder, move both.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ in these two %2$@ can only sit in two %3$@, so no other square in those %3$@ can be a %4$@."
          }
        }
      }
    },
    "difficulty.gentle.title" : {
      "comment" : "Difficulty band, easiest of four. Shown on buttons and menus and on the share card. An adjective in the app's calm register — not \"Easy\", which sounds like a judgement of the player. One or two words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle"
          }
        }
      }
    },
    "difficulty.nocturne.title" : {
      "comment" : "Difficulty band, hardest of four. A night piece — the late, quiet, difficult one. Borrowing the musical term untranslated is fine where that word exists. One or two words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nocturne"
          }
        }
      }
    },
    "difficulty.sharp.title" : {
      "comment" : "Difficulty band, third of four: keen-witted, demanding. NOT the knife and NOT the musical accidental. One or two words.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharp"
          }
        }
      }
    },
    "difficulty.steady.title" : {
      "comment" : "Difficulty band, second of four: unhurried, dependable. Shown on buttons and menus. One or two words.",
