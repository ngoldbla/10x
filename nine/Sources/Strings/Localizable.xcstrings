    "archive.footnote": {
      "comment": "The line under the archive grid. Says both that past boards are regenerated rather than stored, and — the part players actually want to know — that playing one cannot help or hurt the daily streak.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder vergangene Tag, neu erzeugt aus seinem Datum. Einen davon zu lösen, berührt deine Serie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every past day, rebuilt from its date. Solving one never touches your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada día pasado se reconstruye a partir de su fecha. Resolver uno nunca afecta a tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque jour passé, reconstruit à partir de sa date. En résoudre un ne touche jamais votre série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni giorno passato viene ricostruito dalla sua data. Risolverne uno non tocca mai la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "過去のどの日も、その日付から組み直しています。解いても連続記録には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지난 날의 보드는 저장하지 않고 날짜에서 다시 만들어요. 지난 보드를 풀어도 연속 기록에는 영향이 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke voorbije dag wordt opnieuw opgebouwd uit zijn datum. Er een oplossen raakt je reeks nooit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada dia passado é refeito a partir da sua data. Resolver um nunca mexe na sua sequência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "过往的每一天，都由日期重新生成。完成其中一天，不会影响你的连续天数。"
          }
        }
      }
    },
