        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tocar num dígito colocado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点已填数字"
          }
        }
      }
    },
    "grammar.touch.pencilDetail": {
      "comment": "The touch instruction for pencil notes. \"Note\" is a verb in the second sentence.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bleistift ist an. Tippe ein leeres Feld an und notiere eine Ziffer, die du erwägst — Notizen sitzen klein in der Ecke, bis eine echte Ziffer kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil is on. Tap an empty cell and note a digit you're considering — notes sit small in the corner until a real digit lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El lápiz está activado. Toca una casilla vacía y anota un número que estés valorando: las notas quedan pequeñas en la esquina hasta que llega un número de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le crayon est actif. Touchez une case vide et notez un chiffre que vous envisagez — les notes restent petites dans le coin jusqu’à ce qu’un vrai chiffre arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La matita è attiva. Tocca una casella vuota e annota una cifra che stai valutando — le note restano piccole nell'angolo finché non arriva una cifra vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモモードが入っています。空きマスをタップして、迷っている数字を書き留めます。メモは確定の数字が入るまで隅に小さく残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연필이 켜져 있어요. 빈 칸을 탭하고 생각 중인 숫자를 메모해요 — 메모는 진짜 숫자가 들어올 때까지 구석에 작게 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potlood staat aan. Tik op een leeg vakje en noteer een cijfer dat je overweegt — notities staan klein in de hoek tot er een echt cijfer landt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O lápis está ligado. Toque numa célula vazia e anote um dígito que você está considerando — as anotações ficam pequenas no canto até um dígito de verdade chegar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "笔记已打开。轻点空格，记下你正在考虑的数字 —— 笔记小小地待在角落，直到真正的数字落下。"
          }
        }
      }
    },
