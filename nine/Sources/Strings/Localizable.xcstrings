    "firstrun.welcome.tagline": {
      "comment": "Tagline under the welcome heading. \"Couch\" means played from the sofa; the second half says it is on every device the player owns.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku fürs Sofa — überall, wo du sitzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couch sudoku — everywhere you sit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku de sofá, allá donde te sientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sudoku du canapé — partout où vous vous installez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku da divano — ovunque ti siedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ソファで解く数独 — 座る場所どこでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "소파에서 즐기는 스도쿠 — 앉는 곳 어디서나."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku voor op de bank — overal waar je zit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudoku de sofá — onde quer que você se sente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沙发数独 —— 哪里坐下，哪里就能玩。"
          }
        }
      }
    },
