    "coach.cageCombination.sentence": {
      "comment": "Coach explanation on a Killer board: a cage's printed total admits only a few sets of digits, and none of the sets still possible puts this digit in this square. %1$lld is the cage's size and %2$lld is the digit being ruled out. \"Cage\" is the outlined group with a printed total.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Käfig aus %1$lld Feldern kann nur wenige Ziffernsätze aufnehmen, und keiner der noch möglichen setzt hier eine %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cage of %1$lld cells can only hold a few sets of digits, and none of the ones still possible puts a %2$lld here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta jaula de %1$lld casillas solo admite unos pocos conjuntos de dígitos, y ninguno de los posibles pone un %2$lld aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette cage de %1$lld cases n'admet que quelques ensembles de chiffres, et aucun de ceux encore possibles ne place un %2$lld ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa gabbia da %1$lld caselle ammette solo pochi insiemi di cifre, e nessuno di quelli ancora possibili mette un %2$lld qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld マスのこのケージに入る数字の組み合わせは限られており、まだ可能などの組み合わせもここに %2$lld を置きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld칸 케이지에 들어갈 수 있는 숫자 조합은 몇 가지뿐이며, 아직 가능한 어떤 조합도 여기에 %2$lld을 놓지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze kooi van %1$lld vakjes kan maar enkele cijfersets bevatten, en geen van de nog mogelijke zet hier een %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta gaiola de %1$lld quadrados só admite alguns conjuntos de dígitos, e nenhum dos ainda possíveis coloca um %2$lld aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这个 %1$lld 格笼子只能容纳少数几组数字，而仍然可能的组合中没有一组会在这里放 %2$lld。"
          }
        }
      }
    },
    "coach.cageSingle.sentence": {
      "comment": "Coach explanation on a Killer board: only one square of a cage is still empty, so the cage's printed total forces its digit. %1$lld is how many squares the cage has and %2$lld is the digit. \"Cage\" is the outlined group with a printed total.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur ein Feld dieses %1$lld-Feld-Käfigs ist noch leer, also lässt die Käfigsumme nur eine %2$lld zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One square of this %1$lld-cell cage is still empty, so the cage total leaves only a %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo queda una casilla vacía en esta jaula de %1$lld, así que el total de la jaula solo admite un %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une seule case de cette cage de %1$lld est encore vide : le total de la cage n'admet donc qu'un %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una sola casella di questa gabbia da %1$lld è ancora vuota, quindi il totale della gabbia ammette solo un %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この %1$lld マスのケージで空いているのは 1 マスだけなので、ケージの合計から %2$lld しか入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld칸 케이지에서 빈 칸이 하나뿐이므로 케이지 합에 따라 %2$lld만 들어갈 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slechts één vakje van deze kooi van %1$lld is nog leeg, dus de kooisom laat alleen een %2$lld toe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só um quadrado desta gaiola de %1$lld ainda está vazio, então o total da gaiola só admite um %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这个 %1$lld 格笼子里只剩一格是空的，所以笼子的和只能是 %2$lld。"
          }
        }
      }
    },
