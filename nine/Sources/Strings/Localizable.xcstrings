    "grammar.touch.advanceHint": {
      "comment": "One-line reminder of the touch controls, under a tutorial beat. \"Rose\" is the circular picker, \"petal\" one of its segments.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feld antippen öffnet die Rose · Blütenblatt antippen setzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a cell for the rose · tap a petal to place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una casilla para la rosa · toca un pétalo para colocar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez une case pour la rose · touchez un pétale pour placer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca una casella per la rosa · tocca un petalo per inserire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マスをタップでリング · 花びらをタップで入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "칸을 탭해 꽃 열기 · 꽃잎을 탭해 놓기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
