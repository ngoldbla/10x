    "game.tv.remoteHint": {
      "comment": "A chip flashed once per launch on the Apple TV board. \"Click\" is the Siri Remote's clickpad press; ▶︎ is the play/pause key and stays as the glyph.",
      "extractionState": "manual",
      "localizations": {
