    "archive.day.inProgress" : {
      "comment" : "VoiceOver, archive grid. Appended to a spoken date to say that day's puzzle is started but unfinished.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in progress"
          }
        }
      }
    },
    "archive.day.notPlayed" : {
      "comment" : "VoiceOver, archive grid. Appended to a spoken date to say that day's puzzle was never opened. Only ever said of a day that CAN still be played.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "not played"
          }
        }
      }
    },
    "archive.day.solved" : {
      "comment" : "VoiceOver, archive grid. Appended to a spoken date to say that day's puzzle is finished. A fragment: \"12 July 2026, solved\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "solved"
          }
        }
      }
    },
    "archive.day.today" : {
      "comment" : "VoiceOver, archive grid. Appended to a spoken date: \"12 July 2026, today\". A fragment, not a sentence — no capital, no full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "today"
          }
        }
      }
    },
    "archive.footnote" : {
      "comment" : "The line under the archive grid. Says both that past boards are regenerated rather than stored, and — the part players actually want to know — that playing one cannot help or hurt the daily streak.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every past day, rebuilt from its date. Solving one never touches your streak."
          }
        }
      }
    },
    "archive.nextMonth" : {
      "comment" : "VoiceOver label of the › that pages the archive grid forwards.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next month"
          }
        }
      }
    },
    "archive.previousMonth" : {
      "comment" : "VoiceOver label of the ‹ that pages the archive grid backwards.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previous month"
          }
        }
      }
    },
    "archive.title" : {
      "comment" : "Title of the month grid of every past daily puzzle, and the VoiceOver label of the calendar glyph that opens it. A noun — the record of past days.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive"
          }
        }
      }
    },
    "board.action.erase" : {
      "comment" : "A VoiceOver custom action, and the label of the ring's tenth petal: clear the digit in this square. A verb in the imperative.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase"
          }
        }
      }
    },
    "board.action.note" : {
      "comment" : "A VoiceOver custom action on a square, and the label of one petal of the pencil ring. %1$lld is the digit 1-9. \"Note\" is a verb here: write this as a small corner mark rather than a real digit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note %1$lld"
          }
        }
      }
    },
    "board.action.place" : {
      "comment" : "A VoiceOver custom action on a square, and the label of one petal of the digit ring. %1$lld is the digit 1-9. A verb in the imperative — this writes a real digit, not a note.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place %1$lld"
          }
        }
      }
    },
    "board.announce.allDone" : {
      "comment" : "VoiceOver announcement: every instance of one digit is now placed. %1$@ is the digit's plural (\"sevens\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %1$@ done."
          }
        }
      }
    },
    "board.announce.cleared" : {
      "comment" : "VoiceOver announcement after a digit is removed. %1$@ is the digit as a word, lowercase — as in board.announce.placed, do not open the sentence with it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cleared %1$@."
          }
        }
      }
    },
    "board.announce.noteAdded" : {
      "comment" : "VoiceOver announcement after a pencil mark is added. %1$@ is the digit as a word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note %1$@ added."
          }
        }
      }
    },
    "board.announce.noteRemoved" : {
      "comment" : "VoiceOver announcement after a pencil mark is removed. %1$@ is the digit as a word.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note %1$@ removed."
          }
        }
      }
    },
    "board.announce.placed" : {
      "comment" : "VoiceOver announcement after a digit is entered. %1$@ is the digit as a word (\"four\"), and it arrives lowercase: open the sentence with a word of your own rather than with %1$@, so this language's capitalization is yours to decide. A sentence: it ends in a full stop.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placed %1$@."
          }
        }
      }
    },
    "board.announce.remaining" : {
      "comment" : "VoiceOver announcement, spoken straight after board.announce.placed: how many of one digit are still missing. %1$@ is a count word (\"three\"), %2$@ the digit's plural (\"sevens\"). Both arrive lowercase and neither should open the sentence. A language that counts with numerals may write the number into the sentence and let the words go unused.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That leaves %1$@ %2$@ to place."
          }
        }
      }
    },
    "board.announce.solved" : {
      "comment" : "VoiceOver announcement the moment the board is finished. One word, a full sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solved."
          }
        }
      }
    },
    "board.box.empty" : {
      "comment" : "VoiceOver, group scan: how many squares in this 3x3 box are still blank. %1$lld is 1-8.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld empty"
          }
        }
      }
    },
    "board.box.filled" : {
      "comment" : "VoiceOver, group scan: this 3x3 box is complete. A word, not a sentence.",
