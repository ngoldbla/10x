    "difficulty.composeCaption": {
      "comment": "Shown in place of a difficulty card's blurb while that band's board is being generated, which can take seconds. %1$@ is the band's name. An honest apology for a wait, not a progress report.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ braucht einen Moment zum Erzeugen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ takes a moment to compose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ tarda un momento en componerse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ demande un instant de composition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comporre %1$@ richiede un momento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ の盤面は組み上げに少し時間がかかります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 보드는 만드는 데 잠시 걸려요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kost even tijd om samen te stellen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ leva um instante para compor"
          }
        },
        "zh-Hans": {
