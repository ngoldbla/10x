    "difficulty.tempest.explainer": {
      "comment": "The longer explanation of the Tempest band. Names three techniques — translate each the same way as technique.swordfish.name, technique.skyscraper.name and technique.xyWing.name. \"The X-wing family, grown up\" means these are the bigger relatives of the X-Wing. Kept to the length of its siblings so the guide still fits one screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlangt ein Muster über drei Linien: einen Swordfish, einen Wolkenkratzer, ein XY-Wing. Die X-Wing-Familie, erwachsen geworden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a pattern spread across three lines: a swordfish, a skyscraper, an XY-wing. The X-wing family, grown up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige un patrón repartido en tres líneas: un Swordfish, un Rascacielos, un XY-Wing. La familia del X-Wing, ya crecida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige un motif réparti sur trois lignes : un Swordfish, un Gratte-ciel, un XY-Wing. La famille du X-Wing, en plus grand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richiede uno schema esteso su tre linee: un Swordfish, un Grattacielo, un XY-Wing. La famiglia dell'X-Wing, cresciuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3 本のラインにまたがるパターンが必要です。ソードフィッシュ、スカイスクレイパー、XY ウィング。X-Wing 一族の、成長した姿。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세 줄에 걸친 패턴이 필요합니다. 소드피시, 스카이스크래퍼, XY 윙. 자라난 X-Wing 가족입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraagt een patroon over drie lijnen: een Swordfish, een Wolkenkrabber, een XY-Wing. De X-Wing-familie, volwassen geworden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige um padrão espalhado por três linhas: um Swordfish, um Arranha-céu, um XY-Wing. A família do X-Wing, já crescida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要横跨三条线的图案：剑鱼、摩天楼、XY-Wing。这是长大后的 X-Wing 家族。"
          }
        }
      }
    },
