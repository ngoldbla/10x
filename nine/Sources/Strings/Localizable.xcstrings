          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans ces trois lignes, %1$lld ne peut se placer que dans trois colonnes, donc aucune autre case de ces colonnes ne peut être un %1$lld."
          }
        },
        "it": {
          "stringUnit": {
