    "grammar.keyboard.advanceHint": {
      "comment": "One-line reminder of the Mac keyboard controls, under a tutorial beat. ⌘Z is a keyboard shortcut and stays as the glyphs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pfeile bewegen · Ziffern setzen · ⌘Z widerruft"
          }
        },
        "en": {
          "stringUnit": {
