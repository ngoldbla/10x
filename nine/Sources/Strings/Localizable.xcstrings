    "grammar.touch.placeDetail": {
      "comment": "The touch instruction for placing a digit. %1$@ is the target numeral. The parenthesis explains that the ring is laid out like a 3×3 number pad.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe das leuchtende Feld an und dann die %1$@ in der Rose. (Du kannst auch dorthin schnippen — die Rose ist ein 3×3-Ziffernblock.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the glowing cell, then tap the %1$@ in the rose. (You can also flick toward it — the rose is a 3×3 keypad.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca la casilla iluminada y luego toca el %1$@ en la rosa. (También puedes deslizar rápido hacia él: la rosa es un teclado numérico de 3×3.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez la case qui brille, puis touchez le %1$@ dans la rose. (Vous pouvez aussi faire glisser vers lui — la rose est un pavé 3×3.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca la casella illuminata, poi tocca %1$@ nella rosa. (Puoi anche scorrere rapidamente verso la cifra — la rosa è un tastierino 3×3.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "光っているマスをタップし、リングの中の%1$@をタップします。（その方向へフリックしても入ります。リングは 3×3 のキーパッドです。）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빛나는 칸을 탭한 다음 꽃에서 %1$@ 꽃잎을 탭해요. (그쪽으로 튕겨도 돼요 — 꽃은 3×3 키패드예요.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op het oplichtende vakje en tik dan op de %1$@ in de roos. (Je kunt er ook naartoe zwiepen — de roos is een 3×3-toetsenblok.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque na célula acesa e depois no %1$@ da rosa. (Você também pode deslizar na direção dele — a rosa é um teclado 3×3.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点发亮的格子，再轻点花环里的 %1$@。（也可以朝它轻扫 —— 花环就是一个 3×3 的数字键盘。）"
          }
        }
      }
    },
