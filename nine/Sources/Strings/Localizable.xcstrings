          "stringUnit" : {
            "state" : "translated",
            "value" : "Share"
          }
        }
      }
    },
    "share.label" : {
      "comment" : "VoiceOver label of the share chip, and the share sheet's own subject line, so it reads as a phrase rather than a bare verb. \"Solve\" is a noun here: the finished board.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your solve"
          }
        }
      }
    },
    "sheet.dismiss.remote" : {
      "comment" : "Footer of every Apple TV sheet, saying how to leave it. \"Back\" is the Siri Remote's Back button — use the name printed in this language's Apple TV documentation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Back to return"
          }
        }
      }
    },
    "sheet.dismiss.touch" : {
      "comment" : "Footer of every iPhone and iPad sheet, saying how to leave it: touch anywhere outside the panel.",
