      }
    },
    "board.cell.label" : {
      "comment" : "VoiceOver, the name of one square. %1$lld is the row (1-9), %2$lld the column (1-9). A translation may reorder them — German and Japanese both front the column.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Row %1$lld, column %2$lld"
          }
        }
      }
    },
    "board.cell.placeHint" : {
      "comment" : "VoiceOver hint on an empty square, spoken after the label. Describes how to enter a digit on this platform.",
