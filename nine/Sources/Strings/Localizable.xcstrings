    "difficulty.gentle.explainer": {
      "comment": "The longer explanation of the Gentle band, in the difficulty guide. \"A single\" is the sudoku term for a square with only one possibility. Two short sentences — the guide has no room to scroll.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Schritt ist ein Single: nur ein Platz bleibt für die Ziffer. Ein ruhiges erstes Spielfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every step is a single: one place a digit can go. A calm first board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada paso es un único: un solo sitio donde cabe un número. Un primer tablero tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque étape est un singleton : une seule place possible pour un chiffre. Une première grille tranquille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni passo è un singolo: un solo posto dove una cifra può andare. Una prima griglia tranquilla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どの一手も、数字の入る場所が1つだけ。落ち着いて始められる盤面です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 단계가 싱글이에요: 숫자가 들어갈 자리는 한 곳뿐이죠. 차분한 첫 보드예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke stap is een single: er is maar één plek waar een cijfer kan. Een rustig eerste bord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada passo é um único: um só lugar para o dígito. Um primeiro tabuleiro calmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每一步都是唯一数：某个数字只有一处可放。安静的第一个棋盘。"
          }
        }
      }
    },
