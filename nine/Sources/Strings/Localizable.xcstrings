    "grammar.pad.advanceHint": {
      "comment": "One-line reminder of the game controller's controls, under a tutorial beat. \"Circle\" is a button name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linker Stick bewegt · rechter Stick schnippt eine Ziffer · Kreis widerruft, gehalten löscht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left stick moves · right stick flicks a digit · Circle taps undo, holds to erase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El stick izquierdo mueve · un golpe del derecho coloca un número · Círculo deshace, mantenlo para borrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le stick gauche déplace · le stick droit place un chiffre · Rond annule, maintenu il efface"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La levetta sinistra sposta · la destra lancia una cifra · Cerchio annulla, tienilo premuto per cancellare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "左スティックで移動 · 右スティックのフリックで入力 · ○ボタンで取り消し、長押しで消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "왼쪽 스틱으로 이동 · 오른쪽 스틱으로 숫자 튕기기 · 동그라미는 눌러 실행 취소, 길게 눌러 지우기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkerstick beweegt · rechterstick zwiept een cijfer · Cirkel tikt ongedaan, ingedrukt wist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analógico esquerdo move · um toque no direito coloca um dígito · Círculo desfaz, segure para apagar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "左摇杆移动 · 右摇杆轻推填数 · 圆圈键点按撤销，长按清除"
          }
        }
      }
    },
    "grammar.pad.highlightDetail": {
      "comment": "The game controller's instruction for the same-number highlight and the peek. \"Triangle\" and \"L2\" are button names.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bleibe auf einer gesetzten Ziffer und drücke Dreieck — jede Kopie leuchtet auf, Notizen auch. Halte L2, um alles außer dieser Ziffer abzudunkeln. Noch einmal Dreieck schaltet das Licht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest on any placed digit and press Triangle — every copy lights up, pencil notes too. Hold L2 to dim everything except that kind. Triangle again switches the lights off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detente sobre cualquier número colocado y pulsa Triángulo: todas sus copias se iluminan, también las anotaciones. Mantén L2 para atenuar todo lo demás. Otra vez Triángulo y las luces se apagan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posez-vous sur un chiffre placé et appuyez sur Triangle — toutes ses copies s’allument, les notes aussi. Maintenez L2 pour estomper tout le reste. Triangle à nouveau éteint tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermati su una cifra già inserita e premi Triangolo — tutte le sue copie si illuminano, anche le note a matita. Tieni premuto L2 per attenuare tutto tranne quella cifra. Premi di nuovo Triangolo per spegnere le luci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入力済みの数字に合わせて△ボタンを押すと、同じ数字がすべて光ります。メモの数字も一緒です。L2 を押している間は、その数字以外が暗くなります。もう一度△ボタンを押すと消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "놓인 숫자 위에 멈춰 세모를 눌러요. 같은 숫자가 모두 밝아져요 — 연필 메모까지요. L2를 길게 누르면 그 숫자만 남기고 나머지가 어두워져요. 세모를 다시 누르면 불이 꺼져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blijf op een geplaatst cijfer staan en druk op Driehoek — elk exemplaar licht op, potloodnotities ook. Houd L2 ingedrukt om alles behalve dat soort te dimmen. Nogmaals Driehoek dooft de lichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pare sobre qualquer dígito colocado e aperte Triângulo — todas as cópias acendem, as anotações também. Segure L2 para escurecer tudo, menos esse dígito. Triângulo de novo apaga as luzes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停在任意已填数字上，按三角键 —— 所有相同的数字都会亮起，笔记也一样。按住 L2 可以让其余的都暗下去。再按一次三角键关闭。"
          }
        }
      }
    },
