            "state": "needs_review",
            "value": "dejar el cursor quieto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "laisser le curseur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lascia fermo il cursore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カーソルを置く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "커서를 올려 두기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "de cursor parkeren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "deixar o cursor parado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停住光标"
          }
        }
      }
    },
    "grammar.remote.pencilDetail": {
      "comment": "The Siri Remote's full instruction for pencil notes. \"Rose\" is the circular picker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte den Klick auf einem leeren Feld für die Notizrose. Notizen sitzen klein in der Ecke, bis eine echte Ziffer kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold-click an empty cell for the pencil rose. Notes sit small in the corner until a real digit lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén el clic en una casilla vacía para abrir la rosa de lápiz. Las notas quedan pequeñas en la esquina hasta que llega un número de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites un clic long sur une case vide pour la rose du crayon. Les notes restent petites dans le coin jusqu’à ce qu’un vrai chiffre arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clicca e tieni premuto su una casella vuota per la rosa della matita. Le note restano piccole nell'angolo finché non arriva una cifra vera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "空きマスを長押しクリックすると、メモのリングが開きます。メモは確定の数字が入るまで隅に小さく残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빈 칸을 길게 클릭하면 메모 꽃이 열려요. 메모는 진짜 숫자가 들어올 때까지 구석에 작게 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik lang op een leeg vakje voor de potloodroos. Notities staan klein in de hoek tot er een echt cijfer landt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique e segure numa célula vazia para abrir a rosa do lápis. As anotações ficam pequenas no canto até um dígito de verdade chegar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "长按空格打开笔记花环。笔记小小地待在角落，直到真正的数字落下。"
          }
        }
      }
    },
