            "value": "Las flechas mueven · los números colocan · ⌘Z deshace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les flèches déplacent · les chiffres placent · ⌘Z annule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le frecce spostano · le cifre inseriscono · ⌘Z annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "矢印キーで移動 · 数字キーで入力 · ⌘Z で取り消し"
          }
        },
        "ko": {
          "stringUnit": {
