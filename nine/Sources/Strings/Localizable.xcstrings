    "firstrun.beat.detail" : {
      "comment" : "The longer instruction in the first-launch lesson. %1$lld and %2$lld are the SAME digit, written twice — if you reorder the sentence, move both. \"Rose\" is Nine's circular digit picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rose is open on the empty cell. Drag from its middle toward the %1$lld and let go — or just tap the %2$lld. That is the whole game."
          }
        }
      }
    },
    "firstrun.beat.doneDetail" : {
      "comment" : "The second half of the first-launch lesson's ending. \"The shelf\" is the app's start screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every board works exactly like that. Today's is waiting on the shelf."
          }
        }
      }
    },
    "firstrun.beat.doneTitle" : {
      "comment" : "What replaces the instruction once the player places the right digit: the lesson is over because there is nothing more to it. Light, not congratulatory.",
