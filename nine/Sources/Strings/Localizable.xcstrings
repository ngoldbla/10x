    "difficulty.nocturne.blurb": {
      "comment": "One-line blurb under the Nocturne difficulty card. \"Clues\" are the digits the puzzle supplies; Nocturne gives fewer of them than any other band. Very short.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weniger Vorgaben, tiefere Logik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewer clues, deeper logic"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos pistas, lógica más profunda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moins de chiffres, logique plus fine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meno indizi, logica più profonda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手がかりは少なく、論理は深く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "적은 단서, 깊은 논리"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minder aanwijzingen, diepere logica"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos pistas, lógica mais funda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已知更少，逻辑更深"
          }
        }
      }
    },
    "difficulty.nocturne.explainer": {
      "comment": "The longer explanation of the Nocturne band. \"Sharp\" here is the name of the band below it — translate it the same way as `difficulty.sharp.title`. \"Givens\" are the digits the puzzle supplies. One sentence, kept to the length of its three siblings so the guide still fits one screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Logik von Scharf mit den wenigsten Vorgaben: weniger Ziffern zum Start, mehr schwere Schritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharp's logic at the clue floor: fewer givens, more of the hard steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La lógica de Agudo con las pistas al mínimo: menos números dados y más pasos difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La logique d’Affûté avec le minimum de chiffres donnés : plus d’étapes difficiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La logica di Acuta al minimo di indizi: meno numeri dati, più passaggi difficili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鋭敏と同じ論理を、手がかりの下限で。初期値は少なく、難しい手は多くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "날카로움과 같은 논리를 가장 적은 단서로: 주어진 숫자는 더 적고, 어려운 단계는 더 많아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De logica van Scherp op de ondergrens: minder gegeven cijfers, meer zware stappen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A lógica de Perspicaz no limite de pistas: menos números fixos, mais passos difíceis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "和锐利一样的逻辑，但已知数降到最低：给出的更少，难走的步子更多。"
          }
        }
      }
    },
