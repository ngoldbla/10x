    "debrief.headline": {
      "comment": "The one congratulatory sentence in the whole app, shown only when the player resolved a cell with a technique harder than a single. %1$@ is a technique name (already translated, e.g. technique.xWing.name); %2$lld is which placement it was, counting only committed digits. Warm but quiet — this is not a trophy.",
      "extractionState": "manual",
      "localizations": {
