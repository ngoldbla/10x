          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap outside to return"
          }
        }
      }
    },
    "shelf.ambient.empty" : {
      "comment" : "The ambient chip beside the board when the player has neither points nor a streak. Flat and factual, never an encouragement to go and play.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No solves yet"
          }
        }
      }
    },
    "shelf.archive.hint" : {
      "comment" : "VoiceOver hint on the calendar glyph in the corner of the Today card: what opening the archive gets you. A fragment, as VoiceOver hints are.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every past daily, on a month grid"
          }
        }
      }
    },
    "shelf.boards.seeAll" : {
      "comment" : "The quiet link beside the Boards heading on the shelf; opens the full board list. Two words at most.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See all"
          }
        }
      }
    },
    "shelf.boards.seeAllLabel" : {
      "comment" : "VoiceOver label for the \"See all\" link, which is too terse to speak on its own.",
