    },
    "coach.xyWing.sentence": {
      "comment": "Coach sentence for an XY-Wing. \"The ringed square\" is the pivot, drawn with a ring on the board — refer to it however this language would refer to a highlighted square. %1$lld and %2$lld are the pivot's two candidates; %3$lld is the digit being eliminated and appears twice.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das eingekreiste Feld ist eine %1$lld oder eine %2$lld, und so oder so wird eines seiner beiden Partnerfelder eine %3$lld. Also kann kein Feld, das beide Partner sieht, eine %3$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ringed square is %1$lld or %2$lld, and either way one of its two partners becomes a %3$lld. So nothing seeing both partners can be a %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La casilla marcada es un %1$lld o un %2$lld, y en cualquier caso una de sus dos compañeras será un %3$lld. Así que ninguna casilla que vea a las dos compañeras puede ser un %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La case entourée est un %1$lld ou un %2$lld, et dans les deux cas l’une de ses deux partenaires devient un %3$lld. Donc aucune case voyant les deux partenaires ne peut être un %3$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La casella cerchiata è un %1$lld o un %2$lld, e in entrambi i casi una delle sue due compagne diventa un %3$lld. Quindi nessuna casella che vede entrambe le compagne può essere un %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "丸で囲んだマスは %1$lld か %2$lld で、どちらの場合も相方の2マスのどちらかが %3$lld になります。だから両方の相方を見るマスに %3$lld は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동그라미 친 칸에 남은 후보는 %1$lld, %2$lld 두 개예요. 어느 쪽이든 두 짝 칸 가운데 한 곳이 %3$lld 자리가 돼요. 그래서 두 짝 칸을 함께 보는 칸에서는 %3$lld 후보를 지울 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het omcirkelde vakje is een %1$lld of een %2$lld, en hoe dan ook wordt een van zijn twee partners een %3$lld. Dus geen vakje dat beide partners ziet kan een %3$lld zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A célula circulada é %1$lld ou %2$lld, e de um jeito ou de outro uma das duas parceiras vira %3$lld. Então nenhuma célula que vê as duas parceiras pode ser %3$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "圈出的格子是 %1$lld 或 %2$lld，无论哪种情况，它的两个同伴格里都会有一个是 %3$lld。所以同时能看到这两个同伴的格子都不能是 %3$lld。"
          }
        }
      }
    },
    "debrief.close": {
      "comment": "VoiceOver label for the control that dismisses the debrief card. The exact opposite verb of debrief.open, with the same noun phrase from debrief.title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Lösung ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide your solve"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ocultar tu resolución"
          }
        },
        "fr": {
