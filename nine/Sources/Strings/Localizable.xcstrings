    "tutorial.goal.body": {
      "comment": "The rules of sudoku in one sentence, plus what this practice board is. \"Box\" is the 3×3 block — use this language's sudoku vocabulary. The dash is an em dash; the range is an en dash.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fülle jede Zeile, jede Spalte und jeden 3×3-Block mit 1–9 – jede Ziffer genau einmal. Dieses Spielfeld ist fast fertig; du beendest ein Stück davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every row, column and 3×3 box with 1–9 — each digit exactly once. This board is nearly done; you'll finish a piece of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Completa cada fila, cada columna y cada caja de 3×3 con los números del 1 al 9 — cada uno una sola vez. Este tablero está casi terminado; tú completarás una parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplissez chaque ligne, chaque colonne et chaque bloc de 3×3 avec 1–9 — chaque chiffre une seule fois. Cette grille est presque terminée ; vous allez en finir une partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riempi ogni riga, colonna e riquadro 3×3 con 1–9 — ogni cifra una sola volta. Questa griglia è quasi finita; ne completerai un pezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての行、列、3×3のブロックを1〜9で埋めます。同じ数字は一度だけ。この盤面はあと少しです。その一部を仕上げてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 가로줄, 세로줄, 3×3 박스를 1–9로 채워요. 각 숫자는 한 번씩만요. 이 보드는 거의 다 됐어요. 남은 부분을 마무리해 봐요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vul elke rij, elke kolom en elk 3×3-blok met 1–9 — elk cijfer precies één keer. Dit bord is bijna klaar; jij maakt er een stukje van af."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preencha cada linha, coluna e bloco 3×3 com 1–9 — cada número exatamente uma vez. Este tabuleiro está quase pronto; você vai terminar um pedaço dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在每一行、每一列和每个 3×3 宫中填入 1–9，每个数字恰好出现一次。这张棋盘快完成了，你来补完其中一段。"
          }
        }
      }
    },
