          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard saved game"
          }
        }
      }
    },
    "shelf.continue.title" : {
      "comment" : "Title of the shelf card that resumes the free-play board in progress. A verb in the imperative — what tapping it does.",
