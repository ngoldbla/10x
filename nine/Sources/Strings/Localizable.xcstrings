    "coach.nakedSingle.sentence": {
      "comment": "Coach explanation, naked single: this square has only one candidate left. %1$lld is the row (1-9), %2$lld the column (1-9), %3$lld the digit. Sentence-initial in English; put the square wherever your language puts it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Zeile %1$lld, Spalte %2$lld bleibt nur ein Kandidat: %3$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row %1$lld, column %2$lld has one candidate left: %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A la fila %1$lld, columna %2$lld le queda un solo candidato: %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligne %1$lld, colonne %2$lld n’a plus qu’un candidat : %3$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riga %1$lld, colonna %2$lld ha un solo candidato: %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld列 %1$lld行に残る候補は %3$lld だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld행 %2$lld열에 남은 후보는 %3$lld 하나예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rij %1$lld, kolom %2$lld heeft nog één kandidaat: %3$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linha %1$lld, coluna %2$lld tem um único candidato: %3$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld 行第 %2$lld 列只剩一个候选数：%3$lld。"
          }
        }
      }
    },
    "coach.simpleColoring.sentence.trap": {
      "comment": "Coach sentence for simple colouring's trap rule: exactly one of the two colours is the true one, so a square seeing both cannot hold the digit. %1$lld appears twice.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine der beiden gefärbten Gruppen enthält jede %1$lld, also kann kein Feld, das beide Gruppen sieht, eine %1$lld sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the two shaded groups holds every %1$lld, so no square that can see both groups can be a %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno de los dos grupos sombreados contiene todos los %1$lld, así que ninguna casilla que vea ambos grupos puede ser un %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’un des deux groupes colorés contient tous les %1$lld, donc aucune case qui voit les deux groupes ne peut être un %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno dei due gruppi colorati contiene tutti i %1$lld, quindi nessuna casella che vede entrambi i gruppi può essere un %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "色分けした2つのグループのどちらかに %1$lld がすべて入るので、両方のグループを見るマスに %1$lld は入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "색칠한 두 그룹 중 한쪽에 %1$lld 후보가 모두 들어 있어요. 그래서 두 그룹을 함께 보는 칸에서는 %1$lld 후보를 지울 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een van de twee gekleurde groepen bevat elke %1$lld, dus geen vakje dat beide groepen ziet kan een %1$lld zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um dos dois grupos sombreados contém todo %1$lld, então nenhuma célula que vê os dois grupos pode ser %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "两个着色组中必有一组包含所有的 %1$lld，所以同时能看到这两组的格子都不能是 %1$lld。"
          }
        }
      }
    },
    "coach.simpleColoring.sentence.wrap": {
      "comment": "Coach sentence for simple colouring's wrap rule: two squares of the SAME colour can see each other, so that colour is impossible. \"Shaded group\" is the colour class as drawn on the board. %1$lld appears once.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei Felder in einer gefärbten Gruppe sehen einander, also fällt diese ganze Gruppe für die %1$lld weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two squares in one shaded group can see each other, so that whole group is ruled out for %1$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dos casillas del mismo grupo sombreado se ven entre sí, así que ese grupo entero queda descartado para el %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deux cases d’un même groupe coloré se voient, donc ce groupe entier est écarté pour le %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Due caselle dello stesso gruppo colorato si vedono, quindi l’intero gruppo è escluso per il %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同じ色のグループにある2つのマスが互いを見ているので、そのグループ全体が %1$lld の候補から外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "같은 색 그룹의 두 칸이 서로를 보고 있어요. 그래서 그 그룹 전체가 %1$lld 후보에서 빠져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee vakjes in dezelfde gekleurde groep zien elkaar, dus die hele groep valt af voor %1$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Duas células do mesmo grupo sombreado se veem, então esse grupo inteiro fica descartado para %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同一着色组里有两个格子彼此可见，所以整组都不能是 %1$lld。"
          }
        }
      }
    },
    "coach.skyscraper.sentence": {
      "comment": "Coach sentence for a Skyscraper. Two lines each have only two places for the digit and share one of them, so one of the two FAR ends must hold it. \"Seeing\" is sudoku's word for sharing a row, column or box. %1$lld appears twice.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese beiden Linien haben je nur zwei Felder für die %1$lld und teilen sich eines davon. Also steht die %1$lld an einem der beiden fernen Enden, und kein Feld, das beide Enden sieht, kommt dafür infrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These two lines each hold %1$lld in only two squares, and they share one. So one of the far ends is a %1$lld, and nothing seeing both can be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estas dos líneas admiten el %1$lld en solo dos casillas cada una, y comparten una. Así que uno de los dos extremos lejanos es un %1$lld, y ninguna casilla que vea los dos puede serlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces deux alignements n’ont chacun que deux cases pour %1$lld, et ils en partagent une. Donc l’un des deux bouts opposés est un %1$lld, et aucune case voyant les deux ne peut l’être."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Queste due linee hanno solo due caselle ciascuna per %1$lld, e ne condividono una. Quindi uno dei due estremi lontani è un %1$lld, e nessuna casella che li vede entrambi può esserlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この2つのラインでは %1$lld が2マスずつにしか入らず、そのうち1マスを共有しています。だから遠い端のどちらかが %1$lld で、その両方を見るマスには入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 두 줄에서 %1$lld 후보는 각각 두 칸뿐이고, 그중 한 칸을 공유해요. 그래서 먼 쪽 두 끝 가운데 하나가 %1$lld 자리예요. 두 끝을 함께 보는 칸에서는 지울 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze twee lijnen hebben elk maar twee vakjes voor %1$lld, en ze delen er één. Dus een van de verre uiteinden is een %1$lld, en niets dat beide ziet kan dat zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estas duas unidades têm só duas células cada uma para %1$lld, e compartilham uma delas. Então uma das duas pontas distantes é %1$lld, e nada que veja as duas pode ser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这两条线上 %1$lld 都只剩两个格子，而且共用其中一个。所以远端两格里必有一个是 %1$lld，同时能看到这两端的格子都不能是。"
          }
        }
      }
    },
    "coach.slip.sentence": {
      "comment": "Coach card body when two squares contradict each other. Says that nothing can follow, without saying which square is wrong.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwei dieser Felder widersprechen sich, also folgt von hier nichts mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two of these squares disagree, so nothing can follow from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dos de estas casillas se contradicen, así que de aquí no se puede deducir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deux de ces cases se contredisent, donc plus rien ne se déduit d’ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Due di queste caselle si contraddicono, quindi da qui non segue nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このうち2つのマスが食い違っているので、ここから先は導けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 칸 중 두 곳이 서로 어긋나 있어요. 그래서 여기서는 다음 수를 찾을 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twee van deze vakjes spreken elkaar tegen, dus hier volgt niets meer uit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Duas destas células se contradizem, então nada segue daqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这里有两个格子互相矛盾，所以推不出下一步。"
          }
        }
      }
    },
