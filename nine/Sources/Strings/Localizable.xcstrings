        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        }
      }
    },
    "shelf.daily.date" : {
      "comment" : "How a past day's board is named in a list of boards. %1$@ is a date (\"12 Jul 2026\"). \"Daily\" here is a noun — the day's shared puzzle — not an adverb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily · %1$@"
          }
        }
      }
    },
    "shelf.difficulty.label" : {
      "comment" : "VoiceOver label of a free-play difficulty card. %1$@ is the band's name (\"Nocturne\"), %2$@ its one-line blurb. Punctuation only.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "shelf.grace.body" : {
      "comment" : "Body of the streak-held card. Says the missed day cost nothing, without framing rest as something spent — there is no allowance and no counter.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You took yesterday off; one rest day won't cost you."
          }
        }
      }
    },
    "shelf.grace.hint" : {
      "comment" : "VoiceOver hint on the streak-held card: tapping it only makes it go away. A verb phrase in the third person, as VoiceOver hints are.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismisses this card"
          }
        }
      }
    },
    "shelf.grace.label" : {
      "comment" : "VoiceOver label of the streak-held card, joining its heading and its body into one spoken sentence. %1$@ is `shelf.grace.title`, %2$@ `shelf.grace.body`.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "shelf.grace.title" : {
      "comment" : "Heading of the card shown the morning after a missed day was bridged (PRD-13). Reassurance, past tense: the run survived. Never mentions a limit or a count.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your streak held"
          }
        }
      }
    },
    "shelf.history.subtitle" : {
      "comment" : "Subtitle of the Apple TV shelf's History tile — what the sheet behind it holds. A fragment, not a sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points & best times"
          }
        }
      }
    },
    "shelf.points.chip" : {
      "comment" : "The points capsule in the shelf header. %1$lld is a lifetime points total. Very short — it shares a row with the title and the streak chip; abbreviate the unit the way this language does on a scoreboard.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld pts"
          }
        }
