      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See all boards"
          }
        }
      }
    },
    "shelf.boards.subtitleCount" : {
      "comment" : "Subtitle of the Apple TV shelf's Boards tile. %1$lld is how many boards are started but unfinished, always 1 or more.",
