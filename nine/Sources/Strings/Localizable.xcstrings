    "coach.boxLine.sentence.boxToCol" : {
      "comment" : "Coach explanation, box-line reduction pointing OUT of a box along a COLUMN. %1$lld is the digit, %2$lld the box number, %3$lld the column number. %1$lld and %3$lld each appear twice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every %1$lld still possible in box %2$lld sits in column %3$lld, so no other square in column %3$lld can be a %1$lld."
          }
        }
      }
    },
    "coach.boxLine.sentence.boxToRow" : {
      "comment" : "Coach explanation, box-line reduction pointing OUT of a box along a ROW: every place the digit can still go in that box lies on that row, so the rest of the row is clear of it. %1$lld is the digit, %2$lld the box number, %3$lld the row number. %1$lld and %3$lld each appear TWICE — if you reorder, move every occurrence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every %1$lld still possible in box %2$lld sits in row %3$lld, so no other square in row %3$lld can be a %1$lld."
          }
        }
      }
    },
    "coach.boxLine.sentence.colToBox" : {
      "comment" : "Coach explanation, box-line reduction claiming a COLUMN's digit INTO a box. %1$lld is the digit, %2$lld the column number, %3$lld the box number. %1$lld and %3$lld each appear twice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every %1$lld still possible in column %2$lld sits in box %3$lld, so no other square in box %3$lld can be a %1$lld."
          }
        }
      }
    },
    "coach.boxLine.sentence.rowToBox" : {
      "comment" : "Coach explanation, box-line reduction claiming a ROW's digit INTO a box: every place the digit can still go in that row lies inside one box, so the rest of the box is clear of it. %1$lld is the digit, %2$lld the row number, %3$lld the box number. %1$lld and %3$lld each appear twice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every %1$lld still possible in row %2$lld sits in box %3$lld, so no other square in box %3$lld can be a %1$lld."
          }
        }
      }
    },
    "coach.card.label" : {
      "comment" : "VoiceOver label of the coaching card, joining its heading and its sentence into one utterance. %1$@ is a technique name or a card heading, %2$@ the explanation.",
