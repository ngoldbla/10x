    "difficulty.abyss.blurb": {
      "comment": "One-line blurb under the Abyss difficulty card. Refers to colouring one digit's candidates in two alternating colours — match technique.simpleColoring.name. Very short.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Ziffer, zwei Farben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One digit, two colours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un dígito, dos colores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un chiffre, deux couleurs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una cifra, due colori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 つの数字、2 色"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "숫자 하나, 두 가지 색"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eén cijfer, twee kleuren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um dígito, duas cores"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一个数字，两种颜色"
          }
        }
      }
    },
    "difficulty.abyss.explainer": {
      "comment": "The longer explanation of the Abyss band. Describes simple colouring — match technique.simpleColoring.name. \"Forced pairs\" are the two squares a digit must occupy one of. Kept to the length of its siblings so the guide still fits one screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Färbe die erzwungenen Paare einer Ziffer in zwei Farben, bis eine Farbe bricht. Das tiefste Brett, das Nine baut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour one digit's forced pairs two ways until a colour breaks. The deepest board Nine will make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colorea de dos maneras las parejas forzadas de un dígito hasta que un color se rompa. El tablero más profundo que hace Nine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colorie de deux façons les paires forcées d'un chiffre jusqu'à ce qu'une couleur cède. La grille la plus profonde que Nine compose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colora in due modi le coppie forzate di una cifra finché un colore non cede. La griglia più profonda che Nine costruisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 つの数字の確定ペアを 2 色で塗り分け、どちらかの色が破綻するまで追います。Nine がつくる最も深い盤面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "한 숫자의 확정 쌍을 두 가지 색으로 칠해 한쪽 색이 무너질 때까지 따라갑니다. Nine이 만드는 가장 깊은 판입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kleur de gedwongen paren van één cijfer op twee manieren tot een kleur breekt. Het diepste bord dat Nine maakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colora de duas formas os pares forçados de um dígito até uma cor quebrar. O tabuleiro mais profundo que o Nine cria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把一个数字的强制配对染成两种颜色，直到其中一种颜色说不通。Nine 能做出的最深的一盘。"
          }
        }
      }
    },
