    "coach.innieOutie.sentence.box": {
      "comment": "Coach explanation on a Killer board, the \"rule of 45\", for a 3x3 BOX. %1$lld is the box number and %2$lld the digit. See coach.innieOutie.sentence.row.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Block %1$lld summiert sich zu 45, und die Käfige darüber erfassen alle Felder bis auf eines — also ist dieses eine %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Box %1$lld sums to 45, and the cages covering it account for every square but one — so that one is a %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La caja %1$lld suma 45, y las jaulas que la cubren abarcan todas las casillas menos una — así que esa es un %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La boîte %1$lld totalise 45, et les cages qui la couvrent comptent toutes les cases sauf une — celle-là vaut donc %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il blocco %1$lld somma 45, e le gabbie che la coprono contano tutte le caselle tranne una — quella è quindi un %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld ブロックの合計は 45 で、覆っているケージは 1 マスを除くすべてを数えます。よってそのマスは %2$lld です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld번째 박스의 합은 45이고, 이를 덮는 케이지가 한 칸만 빼고 모두 포함하므로 그 칸은 %2$lld입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blok %1$lld telt op tot 45, en de kooien die hem bedekken dekken alle vakjes op één na — dat ene is dus een %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A caixa %1$lld soma 45, e as gaiolas que a cobrem abrangem todos os quadrados menos um — esse é um %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld ブロック的和为 45，覆盖它的笼子涵盖了除一格以外的所有格，所以那一格是 %2$lld。"
          }
        }
      }
    },
    "coach.innieOutie.sentence.col": {
      "comment": "Coach explanation on a Killer board, the \"rule of 45\", for a COLUMN. %1$lld is the column number and %2$lld the digit. See coach.innieOutie.sentence.row.",
