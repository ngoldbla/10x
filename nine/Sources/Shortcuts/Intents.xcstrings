    "intent.boardWidget.description": {
      "comment": "One sentence in the widget-configuration sheet. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das heutige Rätsel, ein Tippen auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's puzzle, one tap at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El puzle de hoy, un toque a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La grille du jour, un geste à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il puzzle di oggi, un tocco alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今日のパズルを、ひとタップずつ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오늘의 퍼즐을 한 번에 한 번씩."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De puzzel van vandaag, tik voor tik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O puzzle de hoje, um toque por vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今天的谜题，一次一下。"
          }
        }
      }
    },
