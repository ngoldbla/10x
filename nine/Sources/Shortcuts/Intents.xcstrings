    "intent.continue.description": {
      "comment": "One sentence under the action name. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet das Spielfeld, das du zuletzt gespielt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopens the board you were last playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a abrir el tablero que estabas jugando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rouvre la grille sur laquelle vous jouiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riapre la griglia su cui stavi giocando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最後に遊んでいた盤面をもう一度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "마지막으로 하던 보드를 다시 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opent het bord waar je het laatst mee bezig was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reabre o tabuleiro em que você estava jogando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新打开你上次在玩的棋盘。"
          }
        }
      }
    },
