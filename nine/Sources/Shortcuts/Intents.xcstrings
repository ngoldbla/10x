    "intent.focus.description": {
      "comment": "One sentence under the filter's name in Settings ▸ Focus. Sentence case. Nine sends no notifications, so this must not promise to silence any.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nimmt Nine die Zählung und den Anstoß, solange dieser Fokus aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes the count and the nudge out of Nine while this Focus is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quita de Nine la cuenta y el empujón mientras este modo esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retire à Nine le compte et l’incitation pendant que ce mode est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toglie a Nine il conteggio e la spinta mentre questo Focus è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この集中モードの間、Nine から数字と催促を取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 집중 모드 동안 Nine 에서 숫자와 재촉을 없앱니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haalt de telling en de aansporing uit Nine zolang deze focus aan staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tira do Nine a contagem e o empurrão enquanto este Foco está ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此专注模式开启时，去掉 Nine 里的计数和催促。"
          }
        }
      }
    },
