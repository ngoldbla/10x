    "intent.startDaily.description": {
      "comment": "One sentence under the action name in the Shortcuts app. Sentence case.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet das heutige Rätsel und erstellt es, wenn du es zum ersten Mal ansiehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens today's puzzle, composing it if this is your first look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el puzle de hoy y lo genera si es la primera vez que lo miras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvre la grille du jour, en la générant si c’est votre première visite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apre il puzzle di oggi, generandolo se è la prima volta che lo guardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今日のパズルを開きます。初めての場合はその場で作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오늘의 퍼즐을 엽니다. 처음이라면 새로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opent de puzzel van vandaag en maakt die aan als je hem nog niet hebt bekeken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre o puzzle de hoje, gerando-o se for a primeira vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开今天的谜题；如果是第一次查看，会先生成。"
          }
        }
      }
    },
