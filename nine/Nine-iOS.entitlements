<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Checked-in copy of the generated Nine.entitlements plus the app
	     group (PRD-3 §3a). Applied only for iPhone/iPad SDKs via
	     CODE_SIGN_ENTITLEMENTS overrides in project.yml, so the tvOS
	     entitlements stay byte-identical. -->
	<key>com.apple.developer.game-center</key>
	<true/>
	<!-- SharePlay (PRD-28 §8). **This is a merge blocker.** Group Activities is
	     a real portal capability — Xcode's own
	     DVTPortalCachedPortalCapabilities.json carries it as GROUP_ACTIVITIES
	     with exactly this profile key — so per EXECUTING-A-PRD §6 the
	     capability must be POSTed to the bundle ID and `match --force` must
	     re-mint the iOS profile BEFORE this merges. CI runs
	     match(readonly: true) and cannot mint anything.

	     iOS only, because PRD-28 §9 ships the parlor on iPhone and iPad only:
	     tvOS can join a group session but cannot place a FaceTime call, and the
	     Mac's parlor is a different design. That scopes the re-mint to one
	     profile instead of three. -->
	<key>com.apple.developer.group-session</key>
	<true/>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.couchsuite.nine</string>
	</array>
	<!-- Cloud library (PRD-8): the private CloudKit database drives CKSyncEngine.
	     Container + capability provisioned on the app ID (team XC6FN96MA8). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.couchsuite.nine</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- CloudKit delivers silent change pushes, so App Store Connect rejects
	     any target that declares icloud-services without aps-environment
	     (upload error 90575). App Store distribution uses the production APS. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
